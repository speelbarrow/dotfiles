# Assembly
e asm.bytes=false
e asm.cmt.right=false
e asm.flags.offset=true
e asm.invhex=true
e asm.lines.fcn=true
e asm.lines.width=5
e asm.sub.names=true
e asm.symbol=true
e asm.xrefs=false

# Clippy
e cfg.fortunes.clippy=true
e cfg.fortunes.type=fun,tips,nsfw

# Misc
e dbg.bpinmaps=false
e hex.align=true
e hex.comments=true
e hex.offset=true
e scr.analbar=true
e scr.color=3
e scr.prompt.code=true
e scr.prompt.flag=true
e scr.prompt.mode=true
e scr.prompt.vi=true
e scr.scrollbar=1
e scr.utf8=true
e scr.utf8.curvy=true
e scr.wheel=true

. ~/.config/radare2/dracula.r2

# Aliases
"$stack=px `dr rbp`-`dr rsp` @ `dr rsp`"
"$stackw=pxw `dr rbp`-`dr rsp` @ `dr rsp`"
"$stackq=pxq `dr rbp`-`dr rsp` @ `dr rsp`"
"$print=!echo -n "
"$println=!echo "

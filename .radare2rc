# Assembly
e asm.bytes=false
e asm.cmt.right=false
e asm.flags.offset=true
e asm.invhex=true
e asm.lines.fcn=true
e asm.lines.width=5
e asm.sub.names=true
e asm.symbol=true
e asm.xrefs=false

# Clippy
e cfg.fortunes.clippy=true
e cfg.fortunes.type=fun,tips,nsfw

# Hexdump
e hex.comments=true

# Visual mode
e scr.scrollbar=1

# Prompt
e scr.prompt.code=true
e scr.prompt.flag=true
e scr.prompt.mode=true
e scr.prompt.vi=true

# Misc
e dbg.bpinmaps=false
e scr.analbar=true
e scr.color=3
e scr.utf8=true
e scr.utf8.curvy=true
e scr.wheel=true
e scr.wheel.speed=1

. ~/.config/radare2/dracula.r2

# Aliases
"$stack=px `dr BP`-`dr SP` @ `dr SP`"
"$stackw=pxw `dr BP`-`dr SP` @ `dr SP`"
"$stackq=pxq `dr BP`-`dr SP` @ `dr SP`"
"$print=!printf "
"$println=!echo "
